     <property name="styleSheet">
      <string notr="true">QTabBar::tab {
    /* 未选中标签样式 */
    background-color: #1E293B; /* 深蓝背景 */
    color: #94A3B8; /* 浅灰文字 */
    padding: 8px 16px;
    margin-right: 2px;
    border-radius: 4px;
    border: none;
    font-weight: 100;
}

QTabBar::tab:selected {
    /* 选中标签样式 */
    background-color: #1E293B; /* 亮蓝背景 */
    color: #00D4FF;
    border: 1px solid #60A5FA; /* 亮蓝边框 */
}

QTabBar::tab:hover:!selected {
    /* 未选中但悬停 */
    background-color: #334155;
    color: #CBD5E1;
}


/* 移除标签栏底部边框 */
QTabWidget::pane {
    border: none;
    background-color: #1E293B; /* 与标签背景协调 */
}

QTabWidget::tab-bar {
    alignment: left; /* 标签左对齐 */
    background-color: transparent;
}</string>
