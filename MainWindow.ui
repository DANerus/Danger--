                  <string notr="true">
QPushButton[checkable=&quot;true&quot;]{
    /* 未选中标签样式 */
    background-color: #1E293B; /* 深蓝背景 */
    color: #94A3B8; /* 浅灰文字 */
    padding: 8px 16px;
    margin-right: 2px;
    border-radius: 8px;
    border: none;
    font-weight: 100;
}

QPushButton[checkable=&quot;true&quot;]:checked {
    /* 选中标签样式 */
    background-color: #1E293B; /* 亮蓝背景 */
    color: #00D4FF;
    border: 1px solid #60A5FA; /* 亮蓝边框 */
}

QPushButton[checkable=&quot;true&quot;]:hover:not(:checked){
    /* 未选中但悬停 */
    background-color: #334155;
    color: #CBD5E1;
}</string>
