                 </property>
                 <property name="styleSheet">
                  <string notr="true">QPushButton {
    /* 正常状态 */
    background-color: #00D4FF; /* 浅灰背景 */
    color: #ffffff; /* 深灰文字 */
    border: 1px solid #cccccc;
    border-radius: 10px;
    padding: 6px 12px;
    font-size: 14px;
}


QPushButton:pressed {
    /* 按压状态（核心效果） */
    background-color: #3B82F6; /* 蓝色背景 */
    color: white; /* 白色文字（与正常状态反转） */
    border-color: #2563EB; /* 深蓝边框 */
}

QPushButton:disabled {
    /* 禁用状态（可选） */
    background-color: #f5f5f5;
    color: #999999;
    border-color: #dddddd;
}</string>
